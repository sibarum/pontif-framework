<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sibarum.pontif</groupId>
        <artifactId>pontif-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>pontif-builtin-shape</artifactId>

    <!--
      SDF shape composition (docs/shapes.md). S1: parameterized primitives + the `SdfShape` trait,
      and two ways to view one: `raymarch` (the field lowered to GLSL, paired with its world box)
      and `gradientField` (the field sampled Pontif-side and clamped to a shell).

      Both RETURN their view rather than drawing it, so this module names no renderer and depends on
      none — not in the pom, not in `requires`, not in the tests. That is what lets a pure SDF-algebra
      assertion run without a window toolkit anywhere near the classpath. It was not always so, and
      the cost was real: `distanceAt` would not link without one. Meshing, attributes and PLY export
      are later slices.
    -->
    <properties>
        <main.class>sibarum.pontif.shape.ShapeLauncher</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ast</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Run a shape .ptf and print the value it evaluates to:
                 mvn -pl pontif-builtin-shape -am exec:exec -Dptf=examples/sphere.ptf -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                        <argument>${ptf}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
