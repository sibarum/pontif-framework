requires pontif.shape.{Sphere, translate, difference, preview}

# docs/shapes.md S3 — constructive solid geometry. A sphere with a smaller sphere carved out of
# it (a bite), previewed as an SDF surface shell. Booleans are min/max over signed distances; this
# is the first preview of a genuinely non-symmetric shape (a lone sphere looked the same under any
# transform). Try union / intersect / smoothUnion in place of difference.
main ( preview(difference(Sphere(1.2), translate(Sphere(0.8), {0.9, 0.0, 0.0}))) )
