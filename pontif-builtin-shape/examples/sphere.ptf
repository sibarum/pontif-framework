requires pontif.shape.{Sphere, preview}

# docs/shapes.md S1 — the first SDF primitive, previewed live. `preview` samples the sphere's
# signed distance field on a 24^3 grid and renders it volumetrically (soft / voxelized; a crisp
# analytic surface trace is a later slice). No mesh exists yet — the field is shown directly.
main ( preview(Sphere(1.0)) )
