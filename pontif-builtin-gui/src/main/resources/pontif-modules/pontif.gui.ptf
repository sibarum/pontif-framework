requires pontif.core.{Stream}
requires pontif.events.{Event}
exports @.{Label, Button, TextField, Column, LinePlot, ExprPlot, window, Clickable, GuiEvent, Clicked, TextChanged, SetText, SetPlot, Status}

# Elements are ordinary structs you CONSTRUCT directly — Label{id = "count", text = "0"},
# Button{id = "inc", text = "go"}, Column{justify = "center", align = "middle", children = {a, b}}.
# The bridge walks the resulting record tree ONCE, switching on each element's type name.
# `id` is the stable handle for isolated updates (SetText) and for a Button's Clicked; the bridge
# records id -> component as it builds. children is `_` so any aggregate of elements fits.
struct Label(id:String, text:String)
struct Button(id:String, text:String)
# An editable single-expression text field (docs/reactive-gui.md §7). `text` is the INITIAL content;
# thereafter the field OWNS its buffer (uncontrolled input) — dasum manages caret/selection, and each
# edit fires TextChanged{id, text}. The app conduit folds that and drives OTHER widgets (a result
# Label via SetText); it does NOT write the field back (that would fight the caret). Programmatic
# SetText on a NON-edited field (a "Clear" button) is still safe.
# `hue` colour-codes the field's text to a plot-series palette slot (0,1,2,…) so a field visually
# matches the curve it drives — the calculator sets each field's hue to its curve index. hue < 0 is
# the default (neutral) text colour, for fields not tied to a curve.
struct TextField(id:String, text:String, hue:Int)
struct Column(justify:String, align:String, children:_)

# A 2D line chart over two number aggregates: LinePlot({0.0,1.0,4.0}, {0.0,1.0,2.0}).
# The bridge converts xs/ys to double[] and renders them in a Component.SceneView
# (dasum-vis), with pan-on-drag / zoom-on-scroll. `_` so any numeric aggregate fits.
struct LinePlot(xs:_, ys:_)

# A RETAINED, reactive expression plot (docs/reactive-gui.md, Slice A): draws `expr` (a math string
# like "x^2 - 4") auto-framed, and is addressable by `id` for live re-plotting via SetPlot(id, expr).
# The bridge holds the SceneView and re-publishes its data in place on each SetPlot — never rebuilt,
# so the camera survives. This is the plotting twin of Label/SetText.
struct ExprPlot(id:String, expr:String)

# A widget the bridge renders as a clickable button and invokes on click. Make your
# own button by subtyping Button and assigning Clickable with an onClick that emits:
#   struct PushButton:[Button](text:String)
#   assign trait PushButton:Clickable { onClick():_ -> emit StdOut("hi")  this }
trait Clickable { onClick():_ }

# The reactive substrate (docs/reactive-gui.md). One conduit folds ALL GUI events into
# the app model by matching this umbrella trait (via ancestry), so an app writes a single
# stateful fold over `GuiEvent` rather than one per widget kind.
trait GuiEvent{}
assign trait GuiEvent:Event{}

# A NOTIFICATION (past-tense: "it happened"): the widget with this `id` was clicked. Clicked is-a
# GuiEvent, so the app's single `GuiEvent` conduit folds it into the model.
struct Clicked(id:String)
assign trait Clicked:GuiEvent{}

# A NOTIFICATION: the editable TextField with this `id` now holds `text` (fired on every edit). Like
# Clicked it is-a GuiEvent, so the app's one conduit folds it — typically parsing/evaluating `text`
# and emitting SetText to a RESULT widget. Uncontrolled: do not SetText the field being edited.
struct TextChanged(id:String, text:String)
assign trait TextChanged:GuiEvent{}

# A COMMAND (imperative: "cause it"): set the text of the retained widget with this `id`. This is an
# ISOLATED update — `emit SetText("count", n + "")` from the conduit mutates just that one widget in
# place (dasum's identity-keyed store), never rebuilding the tree. The dasum-blessed update pattern;
# siblings (SetChecked, SetChildren, …) will join it as the widget set grows.
struct SetText(id:String, text:String)
assign trait SetText:Event{}

# A COMMAND: re-plot the retained ExprPlot with this `id`. `exprs` is either a single expression
# string ("x^2 - 4") or an aggregate of them ({"x^2 - 4", "sin(x)"}) — the bridge composites every
# one that parses into the plot as its own colour-coded curve, auto-framed over all of them. Like
# SetText this is an ISOLATED, in-place update (the SceneView is never rebuilt; the camera survives);
# unparseable entries are skipped, keeping the last good plot. This drives the multi-expression
# calculator: `emit SetPlot("plot", m2.exprs)` from the conduit, live as you type.
struct SetPlot(id:String, exprs:_)
assign trait SetPlot:Event{}

# A COMMAND: surface a message on the status bar (docs/status.md). `kind` is "good" | "bad" | anything
# else (neutral). A "bad" is how the calculator reports a parse error without a popup — it flashes on
# the bar, tints faintly, and lands in the event-log ledger. `emit Status("no real roots", "bad")`.
struct Status(text:String, kind:String)
assign trait Status:Event{}

# The window action (native; the placeholder body is never run): opens a window
# rendering the given root tree on the root thread, until closed.
function window(cfg:_, children:_):Stream[String] -> {}

0
