# The first reactive Pontif GUI (docs/reactive-gui.md, Slice 1). A counter window whose label
# increments on every button click, with ZERO app state held in Java — the model is a Pontif
# value threaded as the conduit's state S.
#
# The loop (docs/reactive-gui.md §1):
#   click a Button -> the bridge fires Clicked{id = "increment"}  (an inbound emit)
#   -> the `app` conduit folds the Clicked into the Model (state S), re-emits Draw(view(model2))
#   -> the Draw native sink stashes the new element tree, marks it dirty, wakes the window loop
#   -> the loop rebuilds the dasum tree from the stashed Pontif tree and repaints.
#
# Run it (needs a display + GLFW; NOT headless):
#   mvn -pl pontif-builtin-gui -am exec:exec -Dptf=examples/reactive-counter.ptf
requires pontif.gui.{Label, Button, Column, window, GuiEvent, Clicked, Draw}

# The app model — a Pontif value, threaded as the conduit's state S.
struct Model(count:Int)

# view : Model -> element tree. `n + ""` int->string (a String operand makes + concatenate);
# there is no intToStr builtin.
function view(m:Model):_ ->
  Column("center", "middle", { Label(m.count + ""), Button("increment") })

# The stateful fold (the crown jewel): every GUI event folds the Model and re-emits a Draw
# command with the freshly-rendered tree. A Clicked bumps the count; any other GUI event passes
# the model through unchanged. `[_]` is the open-world catch-all the open GuiEvent trait requires.
# The `:Model` pass-through sugar returns the new state (the fold body) as S.
conduit app(e:GuiEvent, s:Model):Model from Model(0) -> (
  let m2 = match e { [Clicked] -> Model(s.count + 1)  [_] -> s }
  emit Draw(view(m2))
  m2
)

# Open the window rendering view(initialModel); the conduit + Draw sink drive every repaint.
main ( window({title = "Counter"}, view(Model(0))) )
