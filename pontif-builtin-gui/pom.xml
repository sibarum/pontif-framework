<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sibarum.pontif</groupId>
        <artifactId>pontif-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>pontif-builtin-gui</artifactId>

    <!--
      The `pontif.plot` extension (docs/plotting.md), and one of the two modules that may name the
      dasum GUI toolkit (GLFW/OpenGL) — the framework outside them stays dasum-free, which
      ToolkitContainmentTest enforces.

      It used to carry `pontif.gui` as well. That surface is gone: the GUI is now Anybox, on
      VexelRay, in pontif-builtin-anybox (docs/anybox.md). What keeps THIS module alive is that
      `pontif.shape` does not link without some `pontif.plot` at all — see docs/plotting.md,
      §The renderer seam, which is also where the procedure for dropping it is written down.
    -->
    <properties>
        <main.class>sibarum.pontif.gui.GuiLauncher</main.class>
        <!-- The window toolkit's version, declared HERE and not in the parent: the framework build must not
             know that a GUI toolkit exists, so the coordinate lives in the modules that actually use one
             (this and pontif-playground). Both leave together (docs/plotting.md, §The renderer seam), and
             this is what makes that a clean cut rather than a hunt through the reactor. -->
        <dasum.version>1.0-SNAPSHOT</dasum.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-runtime</artifactId>
        </dependency>
        <!-- The debug port: GuiLauncher attaches a DebugSession when the editor asks it to. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-net</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-core</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <!-- Optional visualization module: 2D plots / 3D scenes rendered into a
             Component.SceneView. Compile scope — DasumBridge imports its plot API. -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-vis</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <!-- Math notation typesetter (MathConstants, and the MathBox IR + backends the render/export
             natives will drive). -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-mathtext</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-glfw</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Native File Dialog (NFDe): the Save-SVG dialog. FileDialog is compile-visible via
             dasum-core, but the nfd native lives here — runtime scope brings the .dll/.dylib. -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-nfd</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Launch a GUI .ptf:
                 mvn -pl pontif-builtin-gui -am exec:exec -Dptf=examples/hello-window.ptf
                 Runs a fresh JVM with native access enabled (GLFW needs it). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                        <argument>${ptf}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
