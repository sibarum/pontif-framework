requires pontif.linalg.{Vec2}

exports @.{vulkanWindow, renderSdf, Frame}

# The per-frame uniform block a shader may take as a second parameter — `time` (seconds) and `resolution`
# (framebuffer size in pixels). The host pushes it every frame; `f.time` / `f.resolution` lower to
# push-constant reads. This is what makes a shader animate. (Graphics-specific, so it lives here; the vector
# types it uses come from pontif.linalg.)
struct Frame(time:Decimal, resolution:Vec2)

# The window action (native; the placeholder body is never run): opens a window presenting a
# fullscreen shader authored in SupirVast's core IR (compiled to SPIR-V), on the root thread, until
# closed. Phase 0 spike: the shader is a fixed constant color.
function vulkanWindow(title:String, width:Int, height:Int):_ -> {}

# renderSdf(shade): present a Vulkan window shading each pixel by a Pontif function of screen uv (and an
# optional Frame). The function is reflected and its body lowered to a SPIR-V fragment through the core IR —
# the shader is authored in Pontif, not GLSL. `shade` is passed as a function value: `$shade[Vec2, Frame]`.
function renderSdf(shade:_):_ -> {}

0
