exports @.{Stream, Nothing, Break, Absent}

trait Stream[type E]{}

struct Nothing()

struct Break()

# The miss value for a stream query's scalar terminal `.first()` (docs/stream-queries.md
# §2.1): `.first()` returns `[T | Absent]` — the found element itself on a hit, or `Absent`
# on a miss. There is NO `Present(T)` wrapper: the element rides unwrapped, so consuming the
# result is an ordinary type-guard match (`[T] -> … [_] -> …`), needing no imported-struct
# destructure. `Absent` is a DISTINCT nominal from `Nothing`/`Break`/`Leaf`/`OutOfRange` —
# the absences answer different questions (docs/stream-queries.md §4.1).
struct Absent()

0
