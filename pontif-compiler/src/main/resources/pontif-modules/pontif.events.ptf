requires pontif.core.{Stream}
exports @.{Event, Sample, EventConduit, EventStream, StdOut, StdErr, stdin}

trait Event{}

# A loss class, declared by the event's sort: `assign trait Moved:Sample{}`. A Sample is a reading - a pointer
# position, a window size, a clock tick - whose next value supersedes it, so when a conductor cannot keep up
# the runtime may replace a queued Moved with a newer Moved and nothing could ever have seen the difference.
# Every other event is an edge: never dropped, and a conductor that cannot hold one halts the program
# rather than lose it. A sample's type is its cell - the latest Moved supersedes any queued Moved - so a
# reading that must not be merged (one per sensor) is a different type per source, or an edge.
trait Sample{}

trait EventConduit[type E, type S, type R]{}

trait EventStream[type R]{}

struct StdOut(text:String)
struct StdErr(text:String)
assign trait StdOut:Event{}
assign trait StdErr:Event{}

# The first inbound source (docs/events.md, "Input is an inbound emit"):
# the Pontif internals produce stdin's lines. The body is a placeholder —
# a resolved `stdin()` call runs this extension's Java object (IoExtension.calls)
# instead, yielding a live demand-driven source pulled lazily by the iterator.
function stdin():Stream[String] -> {}

0
