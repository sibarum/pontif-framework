exports @.{Stream, Nothing, Break, Present, Absent}

trait Stream[type E]{}

struct Nothing()

struct Break()

# The honest-absence union for a stream query's scalar terminal `.first()`
# (docs/stream-queries.md §2.1): `Present(v)` carries the found record, `Absent`
# marks a lookup miss. `Absent` is a DISTINCT nominal from `Nothing`/`Break`/`Leaf`/
# `OutOfRange` — the four absences answer different questions (docs/stream-queries.md §4.1).
# `Present` is non-parametric for now (`value:_`, the floor) — a parametric `Present[T]`
# only pays off once `.first()` ascribes a `[Present(T)|Absent]` result sort (a follow-up;
# see docs/stream-queries.md §5), and the floor field destructures cleanly today.
struct Present(value:_)

struct Absent()

0
