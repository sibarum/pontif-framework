#  (from, from-1, to)
  


struct IntegerRatio(numerator:Int, denominator:Int)

struct Note(fundamental:Decimal, ratio:IntgerRatio)

function generateHarmonics(fundamental:Decimal, denominator:Int):Note ->
  Note(fundamental, IntegerRatio(1, denominator))
