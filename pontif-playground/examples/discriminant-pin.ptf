# Pinning a discriminant base field.
#
# A `struct Sub:Base(...)` must DETERMINE every field of Base, so the demotion
# Sub → Base is total. A base field is determined either by being carried through
# — a same-named field in the SAME constructor position — or by being pinned in
# the is-a morphism.
#
# BiOp holds two operands AND a discriminant `op`. Exp and Log each carry
# left/right by position and pin `op` to their operator. Dropping `op`
# (`struct Exp:BiOp(left, right)`) is now a compile error: op would be
# undetermined, collapsing Exp and Log into indistinguishable BiOps.

struct Expr()
let Operation:Type[String:@=="+" | @=="-"]

struct BiOp:Expr(left:Expr, right:Expr, op:Operation)

# left, right carried by name+position; op pinned to the discriminant.
struct Exp:[BiOp:@.op=="+"](left:Expr, right:Expr)
struct Log:[BiOp:@.op=="-"](left:Expr, right:Expr)

# The pinned `op` is materialized on each subtype's value at construction and
# resolves through the is-a base, so it reads directly off the subtype: an Exp's
# op is "+", a Log's is "-" — no explicit demotion needed.
let leaf = Expr()
let e:Exp = Exp(leaf, leaf)
let l:Log = Log(leaf, leaf)
e.op
