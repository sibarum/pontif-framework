module examples.self_returning_handler

# A conductor handler's return contract (docs/orchestration.md, cut 2).
#
# A bare handler is an Action — effect-only. A `:[this._type]` handler is a
# STATE TRANSITION: it returns Self. `_type` is the universal forced member
# giving a value's concrete sort, so `[this._type]` in return position reads as
# "the sort of this" = Self; the terminal `this` is the (next) version of the
# conductor's state. The contract is honest: the handler is `Self -> Self`.

requires pontif.events.{Event, StdOut}

struct Tick(n:Int)
assign trait Tick:Event{}

conductor Counter {
  count:Int = 0,
  bump(e:Tick):[this._type] -> this.count = this.count + 1  emit StdOut("" + this.count + " ")  this
}

spawn Counter

main ( emit Tick(1)  emit Tick(1)  emit Tick(1)  0 )
