module cott.traction.cd

requires cott.traction.{Traction}

exports @.{TractionCD}

struct TractionCD(n:Traction, d:Traction)

function TractionCD.of(n:Decimal, d:Decimal):TractionCD ->
  TractionCD(Traction.of(n), Traction.of(d))

method TractionCD.toString():String ->
  "tcd<"+this.n.toString()+"/"+this.d.toString()+">"

method TractionCD.normalize():TractionCD ->
  match (this.n, this.d)
    [(t1, t2)] -> TractionCD(t1/t2, Traction(1,0))

function +(
    tcd1:[TractionCD(n1,d1)],
    tcd2:[TractionCD(n2,d2)]
  ):TractionCD ->
    TractionCD(
      n1*d2+n2*d1,
      d1*d2
    )

function -(
    tcd1:[TractionCD(n1,d1)],
    tcd2:[TractionCD(n2,d2)]
  ):TractionCD ->
    TractionCD(
      n1*d2-n2*d1,
      d1*d2
    )

function *(
    tcd1:[TractionCD(n1,d1)],
    tcd2:[TractionCD(n2,d2)]
  ):TractionCD ->
    TractionCD(
      n1*n2,
      d1*d2
    )

function /(
    tcd1:[TractionCD(n1,d1)],
    tcd2:[TractionCD(n2,d2)]
  ):TractionCD ->
    TractionCD(
      n1*d2,
      d1*n2
    )


(
  TractionCD.of(3,-1) / TractionCD.of(0,0)
  +TractionCD.of(0,-2) + TractionCD.of(-3,0) / TractionCD.of(0,0)
).toString()
