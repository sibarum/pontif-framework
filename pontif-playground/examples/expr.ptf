let Expr:Type{
  simplify:[Method():Expr],
  evaluate:[Method():Expr],
  copy:[Method():this.type]
}

let Literal[type T]:Type{
		  value:T
}

struct IntLit(value:Int)

assign trait IntLit:Literal[Int]{}

assign trait IntLit:Expr{
  simplify():Expr -> this
  evaluate():Expr -> this
  copy():IntLit -> this
}

struct AddOp(left:Expr, right:Expr)

assign trait AddOp:Expr{
  simplify():Expr -> match this {
    [AddOp(l:IntLit, r:IntLit)] -> IntLit(l.value + r.value)
    [_]                         -> this
  }
  evaluate():Expr -> this
  copy():AddOp -> this
}

AddOp(IntLit(2), IntLit(3)).simplify()