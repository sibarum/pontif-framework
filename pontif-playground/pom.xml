<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sibarum.pontif</groupId>
        <artifactId>pontif-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>pontif-playground</artifactId>

    <properties>
        <main.class>sibarum.pontif.playground.App</main.class>
        <!-- The window toolkit's version, declared HERE and not in the parent: the framework build must not
             know that a GUI toolkit exists, so the coordinate lives in the modules that actually use one
             (this and pontif-builtin-gui). Both leave together (docs/plotting.md, §The renderer seam), and
             this is what makes that a clean cut rather than a hunt through the reactor. -->
        <dasum.version>1.0-SNAPSHOT</dasum.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-core</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ast</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-runtime</artifactId>
        </dependency>
        <!-- Direct, not just transitive via pontif-runtime: the syntax
             highlighter imports AltParser.KEYWORDS. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-parser</artifactId>
        </dependency>
        <!-- The builtin extensions must be on the editor's classpath: the live in-process compiler
             resolves their modules, and the "Run" subprocess inherits this classpath (App spawns
             `java -cp <inherited> …`). They then self-register via ServiceLoader (docs/extensions.md)
             — adding a new extension is just a new dependency here, no code wiring. pontif-builtin-gui
             pulls -net transitively; -shape reuses the plot render path. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-shape</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- GPU compute (`… on Gpu`, docs/gpu-kernels.md): self-registers via ServiceLoader like the
             other builtin extensions, so the editor's live compiler + the "Run" subprocess resolve
             `pontif.gpu`. Pulls SuperVast (dev.supirvast:*, via pontif-supirvast) onto the classpath;
             SuperVast has a CPU fallback, so this works with or without a Vulkan device. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-gpu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Vulkan graphics (`pontif.vulkan`, docs/vulkan.md): self-registers via ServiceLoader, so
             the editor's live compiler + the "Run" subprocess resolve `pontif.vulkan`. A windowed
             program (routed to GuiLauncher, main thread) that opens a Vulkan window presenting a
             SupirVast core-IR shader. Pulls SuperVast's windowed host (dev.supirvast:vastir-preview)
             + LWJGL onto the classpath. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-vulkan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-core</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <!-- Raster-image + scene rendering (Component.SceneView / ImageLayer) for the
             Welcome-page screenshot thumbnails. Also arrives transitively via
             pontif-builtin-gui; declared explicitly since the editor imports it directly. -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-vis</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-glfw</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-nfd</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pontif-editor</finalName>
        <plugins>
            <!-- Runnable fat jar (Main-Class = App): the artifact `pontif editor`
                 shells out to with `java -jar`. Bundles the dasum GUI runtime and
                 the generated font atlases so it launches standalone. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <!-- Merge each module's META-INF/services/…Extension provider file
                                     so ServiceLoader discovery finds ALL extensions in the fat jar
                                     (without this, shade keeps only one, silently dropping the rest). -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
