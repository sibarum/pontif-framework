<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sibarum.pontif</groupId>
        <artifactId>pontif-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>pontif-playground</artifactId>

    <properties>
        <main.class>sibarum.pontif.playground.App</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-core</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ast</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-runtime</artifactId>
        </dependency>
        <!-- Direct, not just transitive via pontif-runtime: the syntax
             highlighter imports AltParser.KEYWORDS. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-parser</artifactId>
        </dependency>
        <!-- The builtin extensions must be on the editor's classpath: the live in-process compiler
             resolves their modules, and the "Run" subprocess inherits this classpath (App spawns
             `java -cp <inherited> …`). They then self-register via ServiceLoader (docs/extensions.md)
             — adding a new extension is just a new dependency here, no code wiring. pontif-builtin-gui
             pulls -net transitively; -shape reuses the plot render path. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-shape</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- GPU compute (`… on Gpu`, docs/gpu-kernels.md): self-registers via ServiceLoader like the
             other builtin extensions, so the editor's live compiler + the "Run" subprocess resolve
             `pontif.gpu`. Pulls SuperVast (dev.supirvast:*, via pontif-supirvast) onto the classpath;
             SuperVast has a CPU fallback, so this works with or without a Vulkan device. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-gpu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Vulkan graphics (`pontif.vulkan`, docs/vulkan.md): self-registers via ServiceLoader, so
             the editor's live compiler + the "Run" subprocess resolve `pontif.vulkan`. A windowed
             program (routed to GuiLauncher, main thread) that opens a Vulkan window presenting a
             SupirVast core-IR shader. Pulls SuperVast's windowed host (dev.supirvast:vastir-preview)
             + LWJGL onto the classpath. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-builtin-vulkan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-core</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <!-- Raster-image + scene rendering (Component.SceneView / ImageLayer) for the
             Welcome-page screenshot thumbnails. Also arrives transitively via
             pontif-builtin-gui; declared explicitly since the editor imports it directly. -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-vis</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-glfw</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-nfd</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pontif-editor</finalName>
        <plugins>
            <!-- Runnable fat jar (Main-Class = App): the artifact `pontif editor`
                 shells out to with `java -jar`. Bundles the dasum GUI runtime and
                 the generated font atlases so it launches standalone. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <!-- Merge each module's META-INF/services/…Extension provider file
                                     so ServiceLoader discovery finds ALL extensions in the fat jar
                                     (without this, shade keeps only one, silently dropping the rest). -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>sibarum.dasum.gui</groupId>
                <artifactId>dasum-msdf-maven-plugin</artifactId>
                <version>${dasum.version}</version>
                <executions>
                    <execution>
                        <id>generate-atlases</id>
                        <goals>
                            <goal>generate-atlas</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDir>${project.basedir}/src/main/resources/dasum/atlas</outputDir>
                    <atlases>
                        <atlas>
                            <name>primary</name>
                            <font>${project.basedir}/fonts/Noto_Sans/NotoSans-Regular.ttf</font>
                            <!-- Same expanded charset as the dasum-mvp-demo (same NotoSans font):
                                 trimmed to what NotoSans-Regular actually provides (~562 glyphs) —
                                 ASCII, Latin-1, Latin Extended-A (European names: Š Ž Œ Ł Ő Ū đ ...),
                                 typographic punctuation (em/en-dash, curly quotes, ellipsis, bullet,
                                 daggers, primes, per-mille), super/subscripts (x², H₂O), the full
                                 Currency block, the Letterlike block (№ ™ ℗ Ω Å ℃ ℉, script/double-
                                 struck letters), vulgar fractions + Roman numerals, and Greek. Noto
                                 core carries NO arrows, box-drawing, block elements, geometric shapes,
                                 dingbats (check/cross), technical or comparison-math operators, so
                                 those are dropped — use lucide icons or an <extraFonts> merge for them. -->
                            <charset>
                                [0x20, 0x7E], [0xA0, 0xFF], [0x0100, 0x017F],
                                0x2013, 0x2014, 0x2018, 0x2019, 0x201A, 0x201C, 0x201D, 0x201E,
                                0x2026, 0x2022, 0x2020, 0x2021, 0x2030, 0x2032, 0x2033, 0x2039, 0x203A,
                                0x2044, 0x203E, 0x2212,
                                [0x2070, 0x209F],
                                [0x20A0, 0x20BF],
                                [0x2100, 0x214F], [0x2150, 0x218F],
                                [0x0391, 0x03A9], [0x03B1, 0x03C9]
                            </charset>
                            <atlasSize>1024</atlasSize>
                            <fontSize>32</fontSize>
                            <pxRange>4</pxRange>
                        </atlas>
                        <atlas>
                            <name>mono</name>
                            <font>${project.basedir}/fonts/UbuntuSansMono/ubuntusansmono-regular.ttf</font>
                            <!-- Same expanded charset the primary (sans) atlas uses, intersected with
                                 what Ubuntu Sans Mono actually provides (431 of the 562-ish requested
                                 glyphs): ASCII, Latin-1, Latin Extended-A, Greek (upper + lower),
                                 typographic punctuation (em/en-dash, curly quotes, dagger/double-dagger,
                                 bullet, ellipsis, per-mille, primes, single guillemets, fraction slash),
                                 super/subscript DIGITS, common vulgar fractions, and the handful of
                                 Currency + Letterlike glyphs the font carries (€ ₮ ₴ ₸ ₹ ₽; ℓ № ℗ ℠ ™ Ω ℮).
                                 Ubuntu Sans Mono has NO overline, NO super/subscript letters or signs,
                                 NO Roman numerals, and only a fraction of the Currency and Letterlike
                                 blocks — those 182 codepoints are dropped (msdf-atlas-gen would skip
                                 them anyway; excluding them keeps the atlas clean and warning-free). -->
                            <charset>
                                [0x0020, 0x007E], [0x00A0, 0x017F],
                                [0x0391, 0x03A1], [0x03A3, 0x03A9], [0x03B1, 0x03C9],
                                [0x2013, 0x2014], [0x2018, 0x201A], [0x201C, 0x201E],
                                [0x2020, 0x2022], 0x2026, 0x2030, [0x2032, 0x2033], [0x2039, 0x203A],
                                0x2044, 0x2212,
                                0x2070, [0x2074, 0x2079], [0x2080, 0x2089],
                                0x20AC, 0x20AE, 0x20B4, [0x20B8, 0x20B9], 0x20BD,
                                0x2113, [0x2116, 0x2117], 0x2120, 0x2122, 0x2126, 0x212E,
                                [0x2150, 0x2151], [0x2153, 0x215E]
                            </charset>
                            <atlasSize>1024</atlasSize>
                            <fontSize>32</fontSize>
                            <pxRange>4</pxRange>
                        </atlas>
                        <atlas>
                            <name>icons</name>
                            <font>${project.basedir}/fonts/lucide/lucide.ttf</font>
                            <atlasSize>512</atlasSize>
                            <fontSize>40</fontSize>
                            <pxRange>4</pxRange>
                            <icons>
                                <manifest>${project.basedir}/fonts/lucide/info.json</manifest>
                                <manifestFormat>lucide</manifestFormat>
                                <glyphList>play, square, folder, save, file, x, save-all, settings, rotate-ccw, trash-2, chevron-up, chevron-down, search</glyphList>
                                <generatedSourcesDir>${project.build.directory}/generated-sources/dasum-msdf</generatedSourcesDir>
                                <packageName>sibarum.pontif.playground.generated</packageName>
                                <className>Icons</className>
                            </icons>
                        </atlas>
                    </atlases>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn -Pnative -pl pontif-playground -am package` → a standalone native
             `pontif-editor` GUI binary. The dasum GUI ships GraalVM reachability
             metadata (FFM down/upcalls) + run-time initialization for its native
             loaders and its per-platform native libraries (glfw3.dll / libglfw3.dylib,
             nfd.dll / libnfd.dylib) as globbed resources, so native-image embeds the
             right one automatically; this profile only adds the editor's own pieces.
             Needs a GraalVM JDK and, on Windows, the MSVC build tools.

             OS adaptation: this `native` profile is OS-neutral (it just produces the
             binary). The companion `native-macos` profile below auto-activates on macOS
             and wraps that binary into a `Pontif Editor.app` bundle — so a single
             `-Pnative` invocation yields a bare binary on Windows/Linux and a `.app` on
             macOS, with no extra flags. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- Same rule as the CLI: native-image must consume the thin
                         classpath, not the uber-jar (which would bundle the GraalVM
                         SDK builder classes). Disable the fat-jar shade here. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>make-fat-jar</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <!-- prepare-package (NOT package) so the native binary exists
                                     BEFORE the macOS .app assembly step, which runs in `package`
                                     (see the native-macos profile). exec-maven-plugin is anchored
                                     to its earlier declaration in the main <build>, so a same-phase
                                     binding would run the packaging script first, before the binary
                                     existed. Ordering by lifecycle phase is deterministic; ordering
                                     within one phase across profiles is not. -->
                                <phase>prepare-package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>pontif-editor</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- dasum's GLFW/NFD bindings call restricted java.lang.foreign
                                     methods (Linker::downcallHandle / upcallStub). Grant the
                                     (class-path = unnamed) module native access at BUILD time:
                                     native-image bakes the grant into the image, so neither the
                                     editor's own console nor a self-exec "Run" child (childCommand
                                     re-invokes THIS same binary — no bundled `java` to pass a flag
                                     to) prints the "restricted method … has been called" /
                                     "Use enable-native-access=ALL-UNNAMED" warnings (the flag is
                                     the buildArg below). Unlike the
                                     JVM path (App.childCommand / the exec-plugin above, which pass
                                     this as a launcher arg), for a native image this is a build
                                     option only — it cannot be passed to the produced exe. -->
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <!-- The MSDF font atlases are generated into this module's
                                     resources and loaded by classloader (Texture.fromPngResource
                                     / AtlasData.loadFromResource); embed them in the image. -->
                                <buildArg>-H:IncludeResources=dasum/atlas/.*</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- macOS packaging: auto-activated by OS family, so it rides along with
             `-Pnative` on a Mac without the user naming it (and stays dormant on
             Windows/Linux). After native-image produces target/pontif-editor, the
             `package` phase assembles target/Pontif Editor.app around it (Info.plist
             with NSApplication as the principal class, PkgInfo, ad-hoc code signature).

             It binds to `package` AFTER the `native` profile's native-image execution
             (profiles apply in declaration order within a phase). The script no-ops if
             the binary is missing, so this profile is harmless on a plain `mvn package`
             / `mvn install` that did not activate -Pnative. The native binary is
             self-contained (dasum extracts the GLFW/NFD dylibs from its embedded
             resources at runtime), so no dylibs need to be copied into the bundle. -->
        <profile>
            <id>native-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>package-macos-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/native/package-macos-app.sh</argument>
                                        <argument>${project.build.directory}/pontif-editor</argument>
                                        <argument>${project.build.directory}/Pontif Editor.app</argument>
                                        <argument>${project.basedir}/native/Info.plist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
