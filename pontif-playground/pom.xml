<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sibarum.pontif</groupId>
        <artifactId>pontif-framework</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>pontif-playground</artifactId>

    <properties>
        <main.class>sibarum.pontif.playground.App</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-core</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ast</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-ir</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-runtime</artifactId>
        </dependency>
        <!-- Direct, not just transitive via pontif-runtime: the syntax
             highlighter imports AltParser.KEYWORDS. -->
        <dependency>
            <groupId>sibarum.pontif</groupId>
            <artifactId>pontif-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-core</artifactId>
            <version>${dasum.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-glfw</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-nfd</artifactId>
            <version>${dasum.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pontif-editor</finalName>
        <plugins>
            <!-- Runnable fat jar (Main-Class = App): the artifact `pontif editor`
                 shells out to with `java -jar`. Bundles the dasum GUI runtime and
                 the generated font atlases so it launches standalone. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>sibarum.dasum.gui</groupId>
                <artifactId>dasum-msdf-maven-plugin</artifactId>
                <version>${dasum.version}</version>
                <executions>
                    <execution>
                        <id>generate-atlases</id>
                        <goals>
                            <goal>generate-atlas</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDir>${project.basedir}/src/main/resources/dasum/atlas</outputDir>
                    <atlases>
                        <atlas>
                            <name>primary</name>
                            <font>${project.basedir}/fonts/Noto_Sans/NotoSans-Regular.ttf</font>
                            <charset>ascii</charset>
                            <atlasSize>1024</atlasSize>
                            <fontSize>32</fontSize>
                            <pxRange>4</pxRange>
                        </atlas>
                        <atlas>
                            <name>mono</name>
                            <font>${project.basedir}/fonts/UbuntuSansMono/ubuntusansmono-regular.ttf</font>
                            <charset>ascii</charset>
                            <atlasSize>1024</atlasSize>
                            <fontSize>32</fontSize>
                            <pxRange>4</pxRange>
                        </atlas>
                        <atlas>
                            <name>icons</name>
                            <font>${project.basedir}/fonts/lucide/lucide.ttf</font>
                            <atlasSize>512</atlasSize>
                            <fontSize>40</fontSize>
                            <pxRange>4</pxRange>
                            <icons>
                                <manifest>${project.basedir}/fonts/lucide/info.json</manifest>
                                <manifestFormat>lucide</manifestFormat>
                                <glyphList>play, square, folder, save, file, x, save-all, settings, rotate-ccw, trash-2</glyphList>
                                <generatedSourcesDir>${project.build.directory}/generated-sources/dasum-msdf</generatedSourcesDir>
                                <packageName>sibarum.pontif.playground.generated</packageName>
                                <className>Icons</className>
                            </icons>
                        </atlas>
                    </atlases>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn -Pnative -pl pontif-playground -am package` → a standalone native
             `pontif-editor` GUI binary. The dasum GUI ships GraalVM reachability
             metadata (FFM down/upcalls) + run-time initialization for its native
             loaders and bundles glfw3.dll, so native-image picks that up automatically;
             this profile only adds the editor's own pieces. Needs a GraalVM JDK and,
             on Windows, the MSVC build tools. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- Same rule as the CLI: native-image must consume the thin
                         classpath, not the uber-jar (which would bundle the GraalVM
                         SDK builder classes). Disable the fat-jar shade here. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>make-fat-jar</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>pontif-editor</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- The MSDF font atlases are generated into this module's
                                     resources and loaded by classloader (Texture.fromPngResource
                                     / AtlasData.loadFromResource); embed them in the image. -->
                                <buildArg>-H:IncludeResources=dasum/atlas/.*</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
