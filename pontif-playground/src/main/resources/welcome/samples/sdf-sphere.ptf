requires pontif.shape.{Sphere, render}

# docs/shapes.md S1 — the first SDF primitive, rendered live as a real surface. `render` lowers
# the sphere's signed distance field to a GLSL `float map(vec3 p)` and hands it to Dasum's raymarch
# layer (docs/sdf-glsl.md), so what you see is a crisp sphere-traced SURFACE — not a sampled
# volume. Drag to orbit, scroll to zoom.
main ( render(Sphere(1.0)) )
