<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.pontif</groupId>
    <artifactId>pontif-framework</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>pontif-core</module>
        <module>pontif-ast</module>
        <module>pontif-ir</module>
        <module>pontif-predicates</module>
        <module>pontif-defaults</module>
        <module>pontif-receipts</module>
        <module>pontif-conservation</module>
        <module>pontif-parser</module>
        <module>pontif-runtime</module>
        <module>pontif-demo</module>
        <module>pontif-playground</module>
        <module>pontif-cli</module>
        <module>pontif-builtin-gui</module>
        <module>pontif-builtin-net</module>
        <module>pontif-builtin-shape</module>
        <module>pontif-builtin-regex</module>
        <!-- GPU compute (docs/gpu-kernels.md): now reactor modules so the editor can bundle
             `pontif.gpu` like the other builtin extensions. They depend on SuperVast
             (dev.supirvast:*, pinned in pontif-supirvast/pom.xml), which must be `mvn install`-ed
             in ~/.m2 for the reactor to build; SuperVast has a CPU fallback, so `… on Gpu` runs
             even without a Vulkan device. -->
        <module>pontif-supirvast</module>
        <module>pontif-gpu</module>
        <!-- Vulkan graphics (docs/vulkan.md): the `pontif.vulkan` surface + the native that opens a
             Vulkan window presenting a SupirVast core-IR shader. Like pontif-gpu it depends on
             SuperVast (dev.supirvast:*), which must be `mvn install`-ed in ~/.m2. -->
        <module>pontif-builtin-vulkan</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <truffle.version>25.0.1</truffle.version>
        <junit.version>5.11.3</junit.version>
        <picocli.version>4.7.6</picocli.version>
        <!-- Pin the compiler plugin: Maven's default binding is 3.1, which predates
             (and silently ignores) <annotationProcessorPaths> — that quietly breaks the
             elektro-Q / picocli codegen in pontif-builtin-net and pontif-cli when built
             from the CLI (IntelliJ's bundled Maven happens to default to a newer plugin,
             which is why it only bites on the command line). Matches the sibling repos
             (elektroq, supirvast). -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.graalvm.truffle</groupId>
                <artifactId>truffle-api</artifactId>
                <version>${truffle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.truffle</groupId>
                <artifactId>truffle-dsl-processor</artifactId>
                <version>${truffle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-ast</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-ir</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-predicates</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-conservation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-defaults</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-receipts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-parser</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
