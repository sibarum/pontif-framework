<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.pontif</groupId>
    <artifactId>pontif-framework</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>pontif-core</module>
        <module>pontif-ast</module>
        <module>pontif-ir</module>
        <module>pontif-predicates</module>
        <module>pontif-defaults</module>
        <module>pontif-receipts</module>
        <module>pontif-conservation</module>
        <module>pontif-parser</module>
        <module>pontif-runtime</module>
        <module>pontif-demo</module>
        <module>pontif-playground</module>
        <module>pontif-cli</module>
        <module>pontif-builtin-gui</module>
        <module>pontif-builtin-net</module>
        <module>pontif-builtin-shape</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <truffle.version>25.0.1</truffle.version>
        <junit.version>5.11.3</junit.version>
        <dasum.version>1.0-SNAPSHOT</dasum.version>
        <picocli.version>4.7.6</picocli.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.graalvm.truffle</groupId>
                <artifactId>truffle-api</artifactId>
                <version>${truffle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.truffle</groupId>
                <artifactId>truffle-dsl-processor</artifactId>
                <version>${truffle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-ast</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-ir</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-predicates</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-conservation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-defaults</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-receipts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-parser</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.pontif</groupId>
                <artifactId>pontif-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
